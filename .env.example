# Kopieren nach .env und anpassen (docker compose liest .env automatisch)

# Port des HTTP-Servers
PORT=7005

# Öffentliche URL ohne Slash am Ende. Leer lassen = aus dem Request ableiten.
# Hinter einem Reverse-Proxy mit HTTPS unbedingt setzen, z.B.:
# BASE_URL=https://mediathek.example.de
BASE_URL=

# Wie oft die Filmliste aktualisiert wird (Stunden)
UPDATE_INTERVAL_HOURS=6

# Optional: Link zu Ko-fi / PayPal / GitHub Sponsors (erscheint im Add-on und auf der Konfig-Seite)
DONATION_URL=

# Optional: Token für POST /admin/update (manuelles Update per HTTP)
ADMIN_TOKEN=

# Optional: TMDB API-Key für echte Poster von Sendungen und Spielfilmen
# Kostenlos: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Benutzer-/Gruppen-ID für die Dateien in ./data (Synology: `id` im SSH-Terminal, z.B. 1026 / 100)
PUID=1000
PGID=1000

# error | warn | info | debug
LOG_LEVEL=info
