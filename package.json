{
  "name": "stremio-mediathek-addon",
  "version": "3.0.1",
  "description": "Stremio Add-on für die deutschen öffentlich-rechtlichen Mediatheken (ARD, ZDF, ARTE, 3sat, …), Live-TV und Radio – basierend auf MediathekView, iptv-org und radio-browser.info",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "update": "node src/updater/cli.js",
    "test": "node --test \"test/*.test.js\"",
    "vercel-build": "node scripts/build-data.js",
    "build:data": "node scripts/build-data.js"
  },
  "keywords": [
    "stremio",
    "addon",
    "mediathek",
    "ard",
    "zdf",
    "arte",
    "live-tv",
    "radio",
    "mediathekview",
    "sqlite"
  ],
  "author": "Hamido212",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hamido212/stremio-mediathekde-addon.git"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0",
    "unbzip2-stream": "^1.4.3"
  },
  "engines": {
    "node": ">=22"
  }
}
